{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "plugins": ["typescript", "unicorn", "import", "promise", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "off",
    "style": "off",
    "nursery": "off"
  },
  "overrides": [
    {
      "files": ["src/ui/**/*.ts"],
      "rules": {
        "typescript/prefer-readonly-parameter-types": "off",
        "max-lines": [
          "error",
          {
            "max": 400
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 80
          }
        ]
      }
    }
  ]
}
